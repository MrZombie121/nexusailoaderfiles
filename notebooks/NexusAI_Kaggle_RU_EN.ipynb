with gr.Blocks(title='NexusAI Trainer') as app:
    gr.Markdown('# NexusAI — обучение и тестирование')
    with gr.Tab('Обучение / дообучение'):
        with gr.Row():
            size = gr.Dropdown(['100M','300M','1B','3B','6B'], value='300M', label='Конфигурация')
            mode = gr.Radio(['Эпохи','Батчи'], value='Эпохи', label='Считать лимит как')
            amount = gr.Number(value=1, minimum=1, precision=0, label='Количество')
        checkpoint_every_epochs = gr.Number(value=1, minimum=1, precision=0, label='Сохранять чекпойнт каждые N эпох')
        run_name = gr.Textbox(value='nexus_run_01', label='Имя версии обучения')
        place = gr.Dropdown(['Kaggle Working Directory', 'Локально в Kaggle', 'Своя папка'], value='Kaggle Working Directory', label='Куда сохранять')
        custom_root = gr.Textbox(value='/kaggle/working/NexusAI_Custom', label='Своя папка (используется только для варианта «Своя папка»)')
        storage_info = gr.Textbox(label='Будут сохранены следующие файлы', lines=4, interactive=False)
        plan_button = gr.Button('Рассчитать план')
        plan = gr.Textbox(label='План обучения', lines=5, interactive=False)
        resume = gr.Textbox(label='Готовый чекпойнт для дообучения', placeholder='Оставьте пустым для обучения с нуля')
        train_button = gr.Button('Запустить обучение', variant='primary')
        log = gr.Textbox(label='Лог обучения', lines=12)
        loss_plot = gr.LinePlot(x='step', y='loss', title='Loss по шагам', y_title='loss', x_title='step')
        package_button = gr.Button('Сохранить последнюю модель из чекпойнта')
        package_status = gr.Textbox(label='Результат сохранения', lines=4, interactive=False)
        plan_button.click(show_plan, [size, mode, amount], plan)
        for component in [place, custom_root, run_name]:
            component.change(show_storage, [place, custom_root, run_name], storage_info)
        app.load(show_storage, [place, custom_root, run_name], storage_info)
        train_button.click(train_stream, [size, mode, amount, checkpoint_every_epochs, run_name, place, custom_root, resume], [log, loss_plot])
        package_button.click(package_existing, [run_name, place, custom_root], package_status)
    with gr.Tab('Чат'):
        chat_checkpoint = gr.Textbox(value=str(MODEL_ROOT / 'nexus_run_01' / 'model.pt'), label='Путь к модели')
        gr.ChatInterface(fn=chat_answer, additional_inputs=[chat_checkpoint], title='NexusAI Chat', description='Задайте вопрос на русском или английском')
    with gr.Tab('Аналитика'):
        eval_checkpoint = gr.Textbox(value=str(MODEL_ROOT / 'nexus_run_01' / 'model.pt'), label='Путь к модели')
        val_path = gr.Textbox(value=str(DATA_DIR), label='Путь к валидационным данным')
        ppl_button = gr.Button('Рассчитать Perplexity')
        ppl_output = gr.Textbox(label='Результат')
        ppl_button.click(calculate_perplexity, [eval_checkpoint, val_path], ppl_output)
    with gr.Tab('Пакетный тест'):
        eval_checkpoint = gr.Textbox(value=str(MODEL_ROOT / 'nexus_run_01' / 'model.pt'), label='Путь к модели')
        prompts = gr.Textbox(lines=8, label='Промпты — по одному на строку')
        eval_button = gr.Button('Запустить тест')
        results = gr.Dataframe(headers=['prompt','answer'], interactive=False)
        eval_button.click(evaluate, [eval_checkpoint, prompts], results)
print('Gradio запускается. Если ссылка не появилась, смотрите ошибку ниже этой ячейки.')
app.queue().launch(share=True, debug=True, show_error=True)
