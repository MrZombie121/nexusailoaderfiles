<markdown_cell>
## Запуск визуальной панели

В панели можно выбрать YAML-конфигурацию, режим лимита (эпохи или батчи), частоту сохранения чекпойнтов в эпохах, имя версии и место сохранения через меню. Ноутбук сам создаёт папки для весов, чекпойнтов и версии обучения. Во время обучения отображаются текущие шаг, loss, learning rate и график loss. Для дообучения укажите готовый `.pt`-чекпойнт; размер конфигурации должен совпадать с размером исходной модели.
</markdown_cell>

<code_cell>
import yaml, pandas as pd, gradio as gr, torch
from nexus.tokenizer import SimpleTokenizer
from nexus.model import NexusModel
from nexus.generation import generate_text

MODEL_ROOT = Path('/kaggle/working/NexusAI/models')
CHECKPOINT_ROOT = Path('/kaggle/working/NexusAI/checkpoints')
VERSION_ROOT = Path('/kaggle/working/NexusAI/training_versions')
TOKENIZER_PATH = WORK / 'datasets' / 'tokenizer' / 'vocab.json'
STORAGE_PRESETS = {
    'Kaggle Working Directory': Path('/kaggle/working/NexusAI'),
    'Локально в Kaggle': WORK / 'outputs',
}

def storage_paths(place, custom_root, run_name):
    root = Path(custom_root).expanduser() if place == 'Своя папка' and str(custom_root).strip() else STORAGE_PRESETS.get(place, STORAGE_PRESETS['Kaggle Working Directory'])
    model_root, checkpoint_root, version_root = root / 'models', root / 'checkpoints', root / 'training_versions'
    summary = f'Модель: {model_root / run_name / "model.pt"}\nЧекпойнты: {checkpoint_root / run_name}\nВерсия: {version_root / run_name}'
    return model_root, checkpoint_root, version_root, summary

def show_storage(place, custom_root, run_name):
    return storage_paths(place, custom_root, str(run_name).strip() or 'nexus_run_01')[3]

def count_examples():
    return sum(1 for path in DATA_DIR.glob('*.jsonl') for _ in path.open(encoding='utf-8'))

def training_plan(model_size, mode, amount):
    cfg = yaml.safe_load((WORK / 'configs' / f'{model_size}.yaml').read_text(encoding='utf-8'))
    batch_size = int(cfg['training'].get('batch_size', 1))
    examples = count_examples()
    batches_per_epoch = max(1, (examples + batch_size - 1) // batch_size)
    if mode == 'Эпохи':
        epochs = float(amount)
        batches = max(1, int(epochs * batches_per_epoch + 0.999999))
    else:
        batches = max(1, int(amount))
        epochs = batches / batches_per_epoch
    return examples, batch_size, batches_per_epoch, batches, epochs

def show_plan(model_size, mode, amount):
    examples, batch_size, per_epoch, batches, epochs = training_plan(model_size, mode, amount)
    return f'Примеров: {examples}\nBatch size: {batch_size}\nБатчей на эпоху: {per_epoch}\nБудет батчей: {batches}\nЭквивалент эпох: {epochs:.3f}'

def make_config(model_size, max_steps, checkpoint_dir, checkpoint_every_epochs, resume):
    base = yaml.safe_load((WORK / 'configs' / f'{model_size}.yaml').read_text(encoding='utf-8'))
    base['training']['max_steps'] = int(max_steps)
    base['training']['checkpoint_dir'] = str(checkpoint_dir)
    base['training']['checkpoint_every_epochs'] = max(1, int(checkpoint_every_epochs))
    if resume and resume.strip():
        base['training']['resume_from'] = resume.strip()
    path = Path('/tmp/nexus_kaggle_config.yaml')
    path.write_text(yaml.safe_dump(base, allow_unicode=True), encoding='utf-8')
    return path

def package_version(run_name, checkpoint_dir, version_root, model_root, config_path):
    latest = checkpoint_dir / 'latest.pt'
    if not latest.exists():
        return 'Чекпойнт latest.pt не найден'
    
    # Генерация README
    config = yaml.safe_load(config_path.read_text(encoding='utf-8'))
    final_loss = 0.0 # Здесь можно добавить логику считывания последнего loss из логов
    readme_content = f"# NexusAI Model: {run_name}\n\n## Параметры обучения\n- Конфигурация: {config.get('model', {})}\n- Max Steps: {config['training'].get('max_steps')}\n- Batch Size: {config['training'].get('batch_size')}\n- Date: {time.strftime('%Y-%m-%d %H:%M:%S')}\n"

    model_target = model_root / run_name
    version_target = version_root / run_name
    model_target.mkdir(parents=True, exist_ok=True)
    version_target.mkdir(parents=True, exist_ok=True)
    
    shutil.copy2(latest, model_target / 'model.pt')
    shutil.copy2(latest, version_target / 'model.pt')
    shutil.copy2(config_path, model_target / 'config.yaml')
    shutil.copy2(config_path, version_target / 'config.yaml')
    
    (model_target / 'README.txt').write_text(readme_content, encoding='utf-8')
    (version_target / 'README.txt').write_text(readme_content, encoding='utf-8')

    if TOKENIZER_PATH.exists():
        shutil.copy2(TOKENIZER_PATH, model_target / 'vocab.json')
        shutil.copy2(TOKENIZER_PATH, version_target / 'vocab.json')
    (version_target / 'manifest.json').write_text(json.dumps({'run_name': run_name, 'checkpoint': str(latest), 'model': str(model_target / 'model.pt')}, ensure_ascii=False, indent=2), encoding='utf-8')
    return f'Модель сохранена:\n{model_target}'

def calculate_perplexity(checkpoint_path, val_data_path):
    import math
    if not Path(checkpoint_path).exists(): return "Чекпойнт не найден"
    model, tokenizer = load_model(checkpoint_path)
    model.eval()
    from nexus.data_loader import get_data_loader
    loader = get_data_loader(val_data_path, batch_size=1, max_length=128) 
    total_loss = 0
    with torch.no_grad():
        for batch in loader:
            input_ids, targets = batch
            logits = model(input_ids)
            loss = torch.nn.functional.cross_entropy(logits.view(-1, logits.size(-1)), targets.view(-1), ignore_index=-100)
            total_loss += loss.item()
    ppl = math.exp(total_loss / len(loader)) if len(loader) > 0 else 0
    return f"Perplexity: {ppl:.2f}"

def package_existing(run_name, place, custom_root):
    run_name = re.sub(r'[^a-zA-Z0-9_-]+', '_', str(run_name).strip()) or 'run'
    model_root, checkpoint_root, version_root, _ = storage_paths(place, custom_root, run_name)
    checkpoint_dir = Path(checkpoint_root) / run_name
    latest = checkpoint_dir / 'model.pt' if (checkpoint_dir / 'model.pt').exists() else checkpoint_dir / 'latest.pt'
    if not latest.exists():
        return f'Не найден чекпойнт: {checkpoint_dir}'
    state = torch.load(latest, map_location='cpu')
    config_path = Path('/tmp/nexus_existing_config.yaml')
    config_path.write_text(yaml.safe_dump(state.get('config', {}), allow_unicode=True), encoding='utf-8')
    return package_version(run_name, checkpoint_dir, Path(version_root), Path(model_root), config_path)

def train_stream(model_size, mode, amount, checkpoint_every_epochs, run_name, place, custom_root, resume):
    if not any(DATA_DIR.glob('*.jsonl')):
        yield 'Нет JSONL-файлов в datasets/processed', pd.DataFrame(columns=['step','loss','lr'])
        return
    run_name = re.sub(r'[^a-zA-Z0-9_-]+', '_', str(run_name).strip()) or 'run'
    model_root, checkpoint_root, version_root, _ = storage_paths(place, custom_root, run_name)
    examples, batch_size, per_epoch, max_steps, planned_epochs = training_plan(model_size, mode, amount)
    log_prefix = f'План: {examples} примеров; batch_size={batch_size}; батчей на эпоху={per_epoch}; всего батчей={max_steps}; эпох={planned_epochs:.3f}'
    checkpoint_dir = Path(checkpoint_root) / run_name
    config_path = make_config(model_size, max_steps, checkpoint_dir, checkpoint_every_epochs, resume)
    command = [sys.executable, 'train.py', '--config', str(config_path), '--data', str(DATA_DIR), '--max-length', '256']
    process = subprocess.Popen(command, cwd=WORK, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    rows, log_lines = [], [log_prefix]
    for line in process.stdout:
        log_lines.append(line.rstrip())
        match = re.search(r'step=(\d+) loss=([0-9.eE+-]+) lr=([0-9.eE+-]+)', line)
        if match:
            rows.append({'step': int(match.group(1)), 'loss': float(match.group(2)), 'lr': float(match.group(3))})
        yield '\n'.join(log_lines[-30:]), pd.DataFrame(rows)
    code = process.wait()
    log_lines.append(f'--- ОБУЧЕНИЕ ЗАВЕРШЕНО С КОДОМ: {code} ---')
    log_lines.append(f'План: {max_steps} батчей (~{planned_epochs:.3f} эпох)')
    
    # Принудительная попытка упаковки всегда, если есть чекпойнт
    packaging_result = package_version(run_name, checkpoint_dir, Path(version_root), Path(model_root), config_path)
    log_lines.append(f'Результат упаковки модели: {packaging_result}')
    
    yield '\n'.join(log_lines[-30:]), pd.DataFrame(rows)

def load_model(checkpoint_path):
    checkpoint = torch.load(checkpoint_path, map_location='cpu')
    config = checkpoint.get('config')
    if not config:
        raise ValueError('В чекпойнте отсутствует config')
    local_vocab = Path(checkpoint_path).parent / 'vocab.json'
    tokenizer = SimpleTokenizer.load(local_vocab if local_vocab.exists() else TOKENIZER_PATH)
    m = config['model']
    model = NexusModel(
        vocab_size=tokenizer.vocab_size,
        hidden_size=int(m['hidden_size']),
        intermediate_size=int(m['intermediate_size']),
        num_layers=int(m['num_layers']),
        num_heads=int(m['num_heads']),
        num_key_value_heads=int(m.get('num_key_value_heads', m['num_heads'])),
        max_position_embeddings=int(m.get('max_position_embeddings', 2048)),
        dropout=float(m.get('dropout', 0.0))
    )
    raw_state = checkpoint.get('model_state', checkpoint)
    model.load_state_dict(raw_state)
    return model, tokenizer

def chat_answer(message, history, checkpoint_path):
    if not checkpoint_path or not Path(checkpoint_path).exists():
        return 'Укажите существующий путь к checkpoints/latest.pt'
    model, tokenizer = load_model(checkpoint_path)
    return generate_text(model, tokenizer, message, max_new_tokens=128, temperature=0.8, top_k=40)

def evaluate(checkpoint_path, prompts):
    model, tokenizer = load_model(checkpoint_path)
    rows = []
    for prompt in prompts.splitlines():
        if prompt.strip():
            rows.append({'prompt': prompt, 'answer': generate_text(model, tokenizer, prompt, max_new_tokens=128, temperature=0.7, top_k=40)})
    return pd.DataFrame(rows)
</code_cell>

